<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for Horizon.app when package.sh signs with the hardened runtime (MACOS_SIGN_IDENTITY):
     the microphone, for push-to-talk to a companion (docs/companions.md). Ad hoc signing doesn't use it. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
